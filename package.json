{
  "name": "codex-hud",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "A standalone HUD/observability companion for OpenAI Codex CLI.",
  "type": "module",
  "bin": {
    "codex-hud": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "benchmark:phase10": "node --expose-gc scripts/phase10-benchmark.mjs",
    "soak:phase10": "node --expose-gc scripts/phase10-soak.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "commander": "^14.0.0",
    "smol-toml": "^1.8.0",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
